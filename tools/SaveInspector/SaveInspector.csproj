<Project Sdk="Microsoft.NET.Sdk">
  <!-- Read-only save inspector. Links the unchanged production pure C# sources the same
       way Checks/CoreChecks.csproj does; no Unity, no package references. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <LangVersion>9.0</LangVersion>
    <AssemblyName>junk-save-inspector</AssemblyName>
    <RootNamespace>JunkToNeon.SaveInspector</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Deterministic>true</Deterministic>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="$(IntermediateOutputPath)production-sources.txt" LogicalName="production-sources.txt" />
  </ItemGroup>
  <Target Name="FingerprintProductionSources" BeforeTargets="PrepareResources">
    <ItemGroup>
      <ProductionSource Include="@(Compile)" Condition="'%(Compile.IsProductionSource)' == 'true'" />
    </ItemGroup>
    <Error Condition="'@(ProductionSource)' == ''" Text="No linked production sources were selected for the build fingerprint." />
    <GetFileHash Files="@(ProductionSource)" Algorithm="SHA256">
      <Output TaskParameter="Items" ItemName="HashedProductionSource" />
    </GetFileHash>
    <WriteLinesToFile File="$(IntermediateOutputPath)production-sources.txt" Lines="@(HashedProductionSource->'%(Identity)=%(FileHash)')" Overwrite="true" Encoding="UTF-8" />
  </Target>
  <ItemGroup>
    <InternalsVisibleTo Include="SaveInspector.FixChecks" />
    <Compile Include="../../Unity/Assets/Scripts/Core/*.cs" Link="Production/Core/%(Filename)%(Extension)" IsProductionSource="true" />
    <Compile Include="../../Unity/Assets/Scripts/Contracts/*.cs" Link="Production/Contracts/%(Filename)%(Extension)" IsProductionSource="true" />
    <Compile Include="../../Unity/Assets/Scripts/Content/*.cs" Link="Production/Content/%(Filename)%(Extension)" IsProductionSource="true" />
    <Compile Include="../../Unity/Assets/Scripts/Effects/*.cs" Link="Production/Effects/%(Filename)%(Extension)" IsProductionSource="true" />
    <Compile Include="../../Unity/Assets/Scripts/Upgrades/*.cs" Link="Production/Upgrades/%(Filename)%(Extension)" IsProductionSource="true" />
    <Compile Include="../../Unity/Assets/Scripts/Orders/*.cs" Link="Production/Orders/%(Filename)%(Extension)" IsProductionSource="true" />
    <Compile Include="../../Unity/Assets/Scripts/Guidance/*.cs" Link="Production/Guidance/%(Filename)%(Extension)" IsProductionSource="true" />
    <Compile Include="src/*.cs" />
  </ItemGroup>
</Project>
