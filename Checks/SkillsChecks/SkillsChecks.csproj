<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings><Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems><LangVersion>9.0</LangVersion>
    <ContractsSource Condition="'$(ContractsSource)' == ''">../../Unity/Assets/Scripts/Contracts/GameplayContracts.cs</ContractsSource>
    <ChapterContractsSource Condition="'$(ChapterContractsSource)' == ''">../../Unity/Assets/Scripts/Contracts/ChapterContracts.cs</ChapterContractsSource>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(ContractsSource)" Link="Contracts/GameplayContracts.cs" />
    <Compile Include="$(ChapterContractsSource)" Link="Contracts/ChapterContracts.cs" />
    <Compile Include="../../Unity/Assets/Scripts/Upgrades/*.cs" />
    <Compile Include="../../Unity/Assets/Tests/Upgrades/SkillRegression.cs" />
    <Compile Include="../../Unity/Assets/Tests/Upgrades/PricingRegression.cs" />
    <Compile Include="../../Unity/Assets/Tests/Upgrades/R8SkillFixtures.cs" />
    <Compile Include="../../Unity/Assets/Tests/Upgrades/V2SkillFixtures.cs" />
    <Compile Include="../../Unity/Assets/Tests/Upgrades/DeliveryPriceRegression.cs" />
    <Compile Include="../../Unity/Assets/Tests/Upgrades/UpgradeRegression.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>
  <Target Name="RequireSharedContracts" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('$(ContractsSource)') Or !Exists('$(ChapterContractsSource)')" Text="Point ContractsSource and ChapterContractsSource at coordinator-owned source; do not vendor copies." />
  </Target>
</Project>
