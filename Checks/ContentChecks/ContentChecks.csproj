<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <LangVersion>9.0</LangVersion>
    <ContractsDirectory Condition="'$(ContractsDirectory)' == ''">../../Unity/Assets/Scripts/Contracts</ContractsDirectory>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(ContractsDirectory)/*.cs" />
    <Compile Include="../../Unity/Assets/Scripts/Content/*.cs" />
    <Compile Include="../../Unity/Assets/Tests/Content/ContentRegression.cs" />
    <Compile Include="../../Unity/Assets/Tests/Content/ChapterRegression.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>
</Project>
