<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings><Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems><LangVersion>9.0</LangVersion>
    <ProductionRoot>$(FrozenRoot)</ProductionRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(ProductionRoot)/Unity/Assets/Scripts/Core/*.cs" />
    <Compile Include="$(ProductionRoot)/Unity/Assets/Scripts/Contracts/*.cs" />
    <Compile Include="$(ProductionRoot)/Unity/Assets/Scripts/Content/*.cs" />
    <Compile Include="$(ProductionRoot)/Unity/Assets/Scripts/Effects/*.cs" />
    <Compile Include="$(ProductionRoot)/Unity/Assets/Scripts/Upgrades/*.cs" />
    <Compile Include="$(ProductionRoot)/Unity/Assets/Scripts/Orders/*.cs" />
    <Compile Include="$(ProductionRoot)/Unity/Assets/Scripts/Guidance/*.cs" />
    <Compile Include="*.cs" />
  </ItemGroup>
  <Target Name="RequireFrozenRoot" BeforeTargets="PrepareForBuild" Condition="'$(FrozenRoot)' == ''">
    <Error Text="FrozenRoot must identify the immutable exported production tree." />
  </Target>
</Project>
